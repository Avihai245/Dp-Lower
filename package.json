{
  "name": "dp-lower",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dpl/campaign --filter @dpl/main dev",
    "dev:campaign": "pnpm --filter @dpl/campaign dev",
    "dev:main": "pnpm --filter @dpl/main dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start -x studio,imgproxy,edge-runtime,vector,logflare,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "db:test": "bash supabase/tests/run.sh",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    }
  }
}
