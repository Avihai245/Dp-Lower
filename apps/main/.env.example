NEXT_PUBLIC_SITE_URL=https://www.lawoffice.org.il
NEXT_PUBLIC_CAMPAIGN_URL=https://euro-passports.com

# Forms, the eligibility funnel (/apply) and the lead cookie all write to the same Supabase project as the campaign
# (server side only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters; signs the lead cookie and the short-lived "Go to my portal" handoff token.
# MUST be set to the exact same value as the campaign project's APP_SECRET: that project verifies the handoff token
# this one signs.  openssl rand -hex 32
APP_SECRET=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Sender of the "we received your request" acknowledgement. The main site only queues it; the campaign's dispatcher delivers it
# (the Zapier URLs belong to the campaign project)
EMAIL_FROM_NAME="Decker Pex Levi"
EMAIL_FROM_ADDRESS=cases@euro-passports.com
EMAIL_REPLY_TO=office@lawoffice.org.il

# Languages of the campaign public pages: en (English only, the default) or en,he (bilingual: Hebrew edition, language switch, hreflang,
# Hebrew start for visitors in Israel). Set the same value in both projects.
NEXT_PUBLIC_CAMPAIGN_LOCALES=en
