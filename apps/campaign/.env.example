# --- Public URLs ---
NEXT_PUBLIC_SITE_URL=https://euro-passports.com
NEXT_PUBLIC_MAIN_SITE_URL=https://www.lawoffice.org.il
# Optional: the origin used in emailed links. Defaults to NEXT_PUBLIC_SITE_URL (this app), which is right for production.
# NEXT_PUBLIC_CAMPAIGN_URL=https://euro-passports.com

# --- Supabase (new publishable/secret keys or the legacy anon/service_role keys both work) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
# 32+ random characters; signs the lead cookie and unsubscribe/booking links.  openssl rand -hex 32
APP_SECRET=
# Bearer token that authorises POST /api/cron/dispatch (Vercel Cron sends it automatically as CRON_SECRET)
CRON_SECRET=

# --- Email + CRM delivery through Zapier (Catch Hook URLs; see docs/DEPLOYMENT.md) ---
ZAPIER_EMAIL_WEBHOOK_URL=
ZAPIER_CRM_WEBHOOK_URL=
# optional: one hook for both channels
ZAPIER_WEBHOOK_URL=
# optional: adds an x-dpl-signature: sha256=<hmac> header you can verify in a Zap code step
ZAPIER_SIGNING_SECRET=
EMAIL_FROM_NAME=Decker Pex Levi
EMAIL_FROM_ADDRESS=cases@euro-passports.com
EMAIL_REPLY_TO=office@lawoffice.org.il
# Supabase "Send Email" auth hook secret (v1,whsec_...) for password-reset / magic-link emails
SEND_EMAIL_HOOK_SECRET=

# --- Optional: Cloudflare Turnstile on public forms ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
