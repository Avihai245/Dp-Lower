auto-install-peers=true
strict-peer-dependencies=false
# AWS Amplify Hosting's Next.js SSR (Web Compute) packaging can't resolve pnpm's default symlinked node_modules in a
# monorepo, and fails the deploy with "node_modules folder is missing the 'next' dependency". A hoisted, flat
# node_modules (real files, not symlinks) is what Amplify's own monorepo guidance calls for:
# https://github.com/aws-amplify/amplify-hosting/blob/main/FAQ.md#using-a-monorepo-framework
node-linker=hoisted
